# ------------------------------------------------------------------
# Firebase Web App configuration (public, client-side identifiers only)
# ------------------------------------------------------------------
# These values are intentionally safe to expose in frontend code. They
# identify your Firebase project to the SDK and are NOT secrets.
#
# Get them from: Firebase Console -> Project settings -> Your apps -> Web app
#
# NEVER put service-account JSON, private keys, or admin credentials here.
# Those must only ever live server-side (Cloud Functions, Admin SDK, CI secrets).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: only required when using Firebase Realtime Database for
# transient presence / typing indicators (recommended).
VITE_FIREBASE_DATABASE_URL=

# Optional: override the app name (defaults to "[DEFAULT]")
# VITE_FIREBASE_APP_NAME=